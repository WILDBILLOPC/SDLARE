# ─── SDLARE Avatar configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# Port the server listens on
PORT=3000

# ─── HeyGen ───────────────────────────────────────────────────────────────────
# Standard HeyGen API key (Settings → API). Used for photorealistic *video
# generation* (the "Spokesperson" tab) and for listing avatars/voices.
# Get it at: https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=

# ─── HeyGen LiveAvatar (real-time streaming assistant) ─────────────────────────
# LiveAvatar API key, used to mint short-lived session tokens for the live,
# interactive avatar (the "Live Assistant" tab). This may be the same value as
# HEYGEN_API_KEY depending on your account; if live mode 401s, set this
# explicitly to your LiveAvatar key.
LIVEAVATAR_API_KEY=

# Default LiveAvatar / interactive avatar id to use for the live session.
# Leave blank to use whatever your LiveAvatar account is configured with.
LIVEAVATAR_AVATAR_ID=

# ─── Google Gemini (Nano Banana — avatar face generation) ──────────────────────
# Gemini API key for the "Avatar Studio" tab (Gemini 2.5 Flash Image).
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ─── Defaults for the Spokesperson (video generation) tab ──────────────────────
# These pre-fill the UI; users can still pick others from the live lists.
DEFAULT_AVATAR_ID=
DEFAULT_VOICE_ID=
